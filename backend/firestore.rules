rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Predictions collection — no client access
    // All reads/writes go through the Flask backend (Admin SDK bypasses rules)
    match /predictions/{predictionId} {
      allow read, write: if false;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
