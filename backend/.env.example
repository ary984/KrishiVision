# -----------------------------------------------------------------------------
# 1. FIREBASE FIRESTORE METADATA PERSISTENCE (Free Tier)
# -----------------------------------------------------------------------------
# Download Service Account Key JSON from:
# Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Place key file in backend directory as serviceAccountKey.json
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# -----------------------------------------------------------------------------
# 2. FREE IMAGE STORAGE (Cloudinary - Recommended 25GB Free Tier)
# -----------------------------------------------------------------------------
# Get free account at https://cloudinary.com
# Option A: Full connection URL from Dashboard
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Option B: Individual credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# 3. ALTERNATIVE: FIREBASE STORAGE (Paid / Blaze Plan required for bucket)
# -----------------------------------------------------------------------------
# Only set if using Firebase Storage bucket instead of Cloudinary
FIREBASE_STORAGE_BUCKET=

# -----------------------------------------------------------------------------
# 4. LLM API KEY (Weather-Reasoning Agent)
# -----------------------------------------------------------------------------
# Groq API key — get yours at https://console.groq.com
GROQ_API_KEY=

# -----------------------------------------------------------------------------
# 5. SERVER CONFIGURATION
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
